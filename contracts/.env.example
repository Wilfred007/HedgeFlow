# Copy to .env (already gitignored) and fill in. Foundry loads this
# automatically for `forge script`/`forge test`.

# Broadcaster for Deploy.s.sol — its address becomes each vault's controller.
# Needs testnet ETH on every chain you deploy to (use each chain's faucet).
CONTROLLER_PRIVATE_KEY=

# RPC endpoints — foundry.toml's [rpc_endpoints] read these by profile name
# (ethereum_sepolia / arbitrum_sepolia / base_sepolia).
ETH_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Contract verification (optional, needed for `--verify`)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# USDC address for whichever chain --rpc-url targets — differs per chain, so
# set this per invocation rather than leaving one value in .env. Current
# values (engine/src/config/chains.ts has the same, verify before use):
#   ethereum-sepolia: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
#   arbitrum-sepolia: 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
#   base-sepolia:     0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=
