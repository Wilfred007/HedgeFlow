# Per-chain RPC + vault config (PRD §6.2)
ETH_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Controller key authorized to move vault funds — never give this to the AI agent (FR-14)
CONTROLLER_PRIVATE_KEY=

# Circle CCTP V2 / Gateway (see PRD §12 glossary + §7 compliance note)
CIRCLE_API_KEY=

# Model provider for the advisory agent layer (PRD §6.3)
ANTHROPIC_API_KEY=

# Rebalancing engine tuning (FR-5, FR-6)
POLL_INTERVAL_MS=30000
MIN_RESERVE_RATIO=0.2
