# Per-chain RPC + vault config (PRD §6.2)
ETH_SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Controller key authorized to move vault funds — never give this to the AI agent (FR-14)
CONTROLLER_PRIVATE_KEY=

# Circle CCTP V2 / Gateway (see PRD §12 glossary + §7 compliance note)
CIRCLE_API_KEY=

# Model provider for the advisory agent layer (PRD §6.3)
ANTHROPIC_API_KEY=

# Rebalancing engine tuning (FR-5, FR-6)
POLL_INTERVAL_MS=30000
MIN_RESERVE_RATIO=0.2

# CCTP V2 fast-transfer finality threshold (see lib/cctp.ts) — below 2000
# requests Fast Transfer. maxFee is NOT set here: it's basis-point pricing
# that scales with transfer size, fetched live per-run from Circle's
# GET /v2/burn/USDC/fees instead of a static value.
CCTP_MIN_FINALITY_THRESHOLD=1000
CIRCLE_ATTESTATION_API_URL=https://iris-api-sandbox.circle.com

# Optional override for where FR-9's decision log is written; defaults to
# engine/decisions.log
DECISION_LOG_PATH=
